{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InkStone MD",
  "version": "1.5.0",
  "identifier": "com.inkstone.md",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InkStone MD",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "InkStoneMD.Markdown",
        "mimeType": "text/markdown",
        "description": "Markdown 文档"
      },
      {
        "ext": ["txt"],
        "name": "InkStoneMD.Text",
        "mimeType": "text/plain",
        "description": "纯文本"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "nsis-hooks.nsh"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["inkstone"]
      }
    }
  }
}
